# Multi-stage build for GAIA Backend (Python AI/ML Pipeline)
FROM python:3.11-slim AS builder

# Set working directory
WORKDIR /app

# Upgrade pip
RUN pip install --upgrade pip

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libffi-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY backend/python/requirements.txt .

# Install Python dependencies (CPU-only torch to avoid ~2.5GB CUDA downloads)
RUN pip install --no-cache-dir --user \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# Download spaCy language model
RUN python -m spacy download en_core_web_sm

# Production stage
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install runtime dependencies (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -r appuser
RUN mkdir -p /app/models && chown -R appuser:appuser /app/models

# Copy Python dependencies from builder to the new user's home
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Copy application code
COPY --chown=appuser:appuser backend/python/ ./backend/python/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PATH=/home/appuser/.local/bin:$PATH

USER appuser

# Expose port
EXPOSE 8000

# Health check for DigitalOcean App Platform deployment
# The app platform will use this to ensure the container is ready
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/api/status || exit 1

# DigitalOcean App Platform uses startCommand from app.yaml - no CMD needed here
