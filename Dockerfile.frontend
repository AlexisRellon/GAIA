# Multi-stage build for GAIA Frontend (React PWA)
FROM node:20-alpine AS development

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY frontend/ .

# Build production assets
RUN npm run build

# Production stage with Nginx
FROM nginx:stable-alpine AS production

# Copy built assets from development stage
COPY --from=development /app/build /usr/share/nginx/html

# Copy Nginx configuration for SPA with security headers
RUN echo 'server { \
  listen 8080; \
  server_tokens off; \
  add_header X-Content-Type-Options "nosniff" always; \
  add_header X-Frame-Options "DENY" always; \
  add_header X-XSS-Protection "1; mode=block" always; \
  root /usr/share/nginx/html; \
  index index.html; \
  location / { \
    try_files $uri $uri/ /index.html; \
  } \
}' > /etc/nginx/conf.d/default.conf

# Setup unprivileged user permissions
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html /var/run && \
    touch /var/run/nginx.pid && chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose port for production
EXPOSE 8080

# Health check to detect and restart unresponsive containers
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

